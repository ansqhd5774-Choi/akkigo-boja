<!-- AKKIGO SERVER DIRECTORY: Blogger refreshes links on publication. -->
<b:if cond='data:view.isHomepage'>
<div class='ncp-server-directory' style='max-width:1180px;margin:24px auto;padding:0 24px;box-sizing:border-box;color:#173454'>
<b:section id='search-directory' maxwidgets='1' showaddelement='no'>
<b:widget id='BlogArchive2' locked='true' title='전체 글 목록' type='BlogArchive' visible='true'>
<b:widget-settings>
<b:widget-setting name='showStyle'>HIERARCHY</b:widget-setting>
<b:widget-setting name='showPosts'>true</b:widget-setting>
<b:widget-setting name='frequency'>MONTHLY</b:widget-setting>
<b:widget-setting name='chronological'>false</b:widget-setting>
<b:widget-setting name='yearPattern'>yyyy</b:widget-setting>
<b:widget-setting name='monthPattern'>MMMM</b:widget-setting>
</b:widget-settings>
<b:includable id='main' var='this'>
<details style='border:1px solid #d9e4f2;border-radius:12px;padding:16px'>
<summary style='cursor:pointer;font-weight:700;font-size:18px'>전체 글 목록</summary>
<nav aria-label='전체 쿠폰 안내 글'><b:include data='data:this.data' name='directoryIntervals'/></nav>
</details>
</b:includable>
<b:includable id='directoryIntervals' var='intervals'>
<b:loop values='data:intervals' var='interval'>
<p><a expr:href='data:interval.url'><data:interval.name/> 글 전체 보기</a></p>
<b:if cond='data:interval.posts'>
<ul style='list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:8px'>
<b:loop values='data:interval.posts' var='post'><li><a expr:href='data:post.url' style='display:block;padding:8px;line-height:1.6;overflow-wrap:anywhere'><data:post.title/></a></li></b:loop>
</ul>
</b:if>
<b:if cond='data:interval.data'><b:include data='data:interval.data' name='directoryIntervals'/></b:if>
</b:loop>
</b:includable>
</b:widget>
</b:section>
</div>
</b:if>

