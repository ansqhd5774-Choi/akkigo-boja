{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akkigo-boja",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "assets": { "directory": "theme/assets" },
  "vars": {
    "BLOGGER_BLOG_ID": "2339978524893611480",
    "BLOGGER_PUBLIC_URL": "https://lsifl.blogspot.com",
    "PUBLISH_ENABLED": "true"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "akkigo-boja-state",
    "database_id": "43e02240-a390-4d8b-bb99-28d329bb72fe",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["0 */6 * * *"] }
}

